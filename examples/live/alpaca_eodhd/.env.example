# -------------------------------------------------------------------------------------------------
# API Configuration for Live Trading Examples
# -------------------------------------------------------------------------------------------------
#
# This file contains environment variables needed for the live trading examples.
# Copy this file to .env and fill in your actual API keys.
#
# IMPORTANT: Never commit your actual .env file with real API keys to version control!
#
# -------------------------------------------------------------------------------------------------

# ================================
# ALPACA CONFIGURATION (Required)
# ================================
# Get your API keys from: https://alpaca.markets/
# Steps:
#   1. Sign up for a free Alpaca account
#   2. For paper trading: Navigate to "Paper Trading" -> "API Keys"
#   3. For live trading: Navigate to "Live Trading" -> "API Keys"

# API Credentials
ALPACA_API_KEY=your_api_key_here
ALPACA_API_SECRET=your_api_secret_here

# API Endpoint (optional - defaults based on ALPACA_PAPER setting)
# Paper trading: https://paper-api.alpaca.markets/v2
# Live trading: https://api.alpaca.markets/v2
ALPACA_ENDPOINT=https://paper-api.alpaca.markets/v2

# Trading Mode
# true = Paper trading (virtual money, safe for testing)
# false = Live trading (REAL money, use with caution!)
ALPACA_PAPER=true

# Data Feed
# IEX = Free data feed (15-min delayed for most, real-time for IEX-listed)
# SIP = Paid subscription (full real-time NBBO from all US exchanges)
ALPACA_DATA_FEED=IEX

# ================================
# EODHD CONFIGURATION (Optional)
# ================================
# Required only for eodhd_alpaca_ema_cross.py (dual-source example)
# Get your API key from: https://eodhd.com/
# Steps:
#   1. Sign up for an EODHD account
#   2. Navigate to your dashboard
#   3. Find your API key in the "API Token" section

EODHD_API_KEY=your_eodhd_api_key_here

# ================================
# QUICK START CONFIGURATIONS
# ================================
#
# PAPER TRADING (Recommended for testing):
# -----------------------------------------
#   ALPACA_API_KEY=<your paper key>
#   ALPACA_API_SECRET=<your paper secret>
#   ALPACA_ENDPOINT=https://paper-api.alpaca.markets/v2
#   ALPACA_PAPER=true
#   ALPACA_DATA_FEED=IEX
#
# LIVE TRADING (Use with caution!):
# ----------------------------------
#   ALPACA_API_KEY=<your live key>
#   ALPACA_API_SECRET=<your live secret>
#   ALPACA_ENDPOINT=https://api.alpaca.markets/v2
#   ALPACA_PAPER=false
#   ALPACA_DATA_FEED=SIP  # Recommended for live trading
